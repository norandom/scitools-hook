{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Analysis",
          "organization": "SciTools",
          "version": "1262",
          "rules": [{ "id": "UND_WARNING" }, { "id": "UND_ERROR" }]
        }
      },
      "artifacts": [
        {
          "location": { "uri": "after/pkg/unparsable.py", "uriBaseId": "UND_PROJECT" },
          "roles": ["analysisTarget", "resultFile"]
        }
      ],
      "originalUriBaseIds": {
        "UND_PROJECT": {
          "description": { "text": "The directory containing the Understand project" },
          "uri": "file:///nowhere/scitools-hook/fixture/"
        }
      },
      "results": [
        {
          "ruleId": "UND_ERROR",
          "ruleIndex": 1,
          "message": { "text": "unexpected indent" },
          "fingerprints": { "understand/v1": "0c6d7153-4f846b05-6f0141bc" },
          "locations": [
            {
              "id": 0,
              "physicalLocation": {
                "artifactLocation": { "index": 0 },
                "region": { "startLine": 12 }
              }
            }
          ]
        }
      ]
    }
  ]
}
